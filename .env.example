# Скопіюй цей файл у .env і заміни значення на власні.
# .env у git не потрапляє, цей шаблон потрапляє.

# Пароль SA для SQL Server: мінімум 8 символів, великі й малі літери, цифри або спецсимволи.
# Інакше контейнер SQL Server не стартує.
MSSQL_SA_PASSWORD=ChangeMe_Strong123!

# Ключ підпису JWT: мінімум 32 символи (див. перевірку JwtSettings).
JWT_KEY=change-me-to-a-long-random-string-32chars-min
